void wyszukajElementy(struct element* poczatek)
{
    char fraza[50];
    printf("\nPodaj fragment tekstu do wyszukania: ");
    scanf("%s", fraza);

    // konwersja wyszukiwanej frazy na małe litery
    for (int i = 0; fraza[i]; i++)
        fraza[i] = tolower(fraza[i]);

    struct element* E = poczatek;
    int lp = 1;
    int znaleziono = 0;

    printf("\n----- WYNIKI WYSZUKIWANIA -----\n");

    while (E != NULL)
    {
        char tytul[50], wydawca[50], platformy[50];

        // kopie pól w wersji lowercase
        strcpy(tytul, E->tytul);
        strcpy(wydawca, E->wydawca);
        strcpy(platformy, E->platformy);

        for (int i = 0; tytul[i]; i++) tytul[i] = tolower(tytul[i]);
        for (int i = 0; wydawca[i]; i++) wydawca[i] = tolower(wydawca[i]);
        for (int i = 0; platformy[i]; i++) platformy[i] = tolower(platformy[i]);

        // szukanie fragmentu
        if (strstr(tytul, fraza) || strstr(wydawca, fraza) || strstr(platformy, fraza))
        {
            wyswietlDane(E, lp);
            znaleziono = 1;
        }

        E = E->nastepny;
        lp++;
    }

    if (!znaleziono)
        printf("\nBrak wyników.\n");

    printf("\n--------------------------------\n");
}


