void usunElement(struct element** poczatek, struct element** koniec)
{
    int lp;
    printf("Wybierz element: ");
    scanf("%d", &lp);

    struct element* E = *poczatek;
    int i = 1;

    while (E != NULL && i < lp)
    {
        E = E->nastepny;
        i++;
    }

    if (E == *koniec)
    {
        *koniec = E->poprzedni;
        (*koniec)->nastepny = NULL;
    }
    else if (E == *poczatek)
    {
        *poczatek = E->nastepny;
        (*poczatek)->poprzedni = NULL;

    }
    else
    {
        E->poprzedni->nastepny = E->nastepny;
        E->nastepny->poprzedni = E->poprzedni;
    }
    free(E);
}

void wyswietlDane(struct element* element, int* lp)
{
    printf("|%3d | %26s | %5d | %18s | %16s | %4d  |\n", lp, element->tytul, element->rok, element->wydawca, element->platformy, element->ocena);
}

void wyswietlanieListy(struct element* poczatek)
{
    struct element* pomocniczy = poczatek;
    int lp = 1;
    printf("\n.-----------------------------------------------------------------------------------------.\n");
    printf("| lp |            tytul           |  rok  |       wydawca      |     platformy    | ocena |\n");
    printf("|-----------------------------------------------------------------------------------------|\n");
    while (pomocniczy != NULL)
    {
        wyswietlDane(pomocniczy, lp);
        pomocniczy = pomocniczy->nastepny;
        lp++;
    }
    printf("'-----------------------------------------------------------------------------------------'\n\n");
}

void czyszczenieListy(struct element* poczatek)
{
    struct element* pomocniczy = poczatek;
    while (pomocniczy != NULL)
    {
        struct element* doUsuniecia = pomocniczy;
        pomocniczy = pomocniczy->nastepny;
        free(doUsuniecia);
    }
}

void zamiana(struct  element** poczatek, struct element** koniec, struct element* E)
{

    //1 etap
    if (E->poprzedni)
    {
        E->poprzedni->nastepny = E->nastepny;
    }
    else
    {
        *poczatek = E->nastepny;
    }
    E->nastepny->poprzedni = E->poprzedni;

    //2 etap
    E->poprzedni = E->nastepny;
    E->nastepny = E->poprzedni->nastepny;

    //3 etap
    E->poprzedni->nastepny = E;
    if (E->nastepny)
    {
        E->nastepny->poprzedni = E;
    }
    else
    {
        *koniec = E;
    }
}

void sortujPoTytule(struct element** poczatek, struct element** koniec)
{
    int zmiana;
    do
    {
        zmiana = 0;
        struct element* aktualny = *poczatek;

        while (aktualny && aktualny->nastepny)
        {
            if (_stricoll(aktualny->tytul, aktualny->nastepny->tytul) > 0)
            {
                zamiana(poczatek, koniec, aktualny);
                zmiana = 1;
            }
            else
            {
                aktualny = aktualny->nastepny;
            }
        }
    } while (zmiana);
    printf("\nSortowanie po tytule zostalo wykonane.\n\n");
}

